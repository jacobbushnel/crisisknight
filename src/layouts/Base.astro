---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { site, links } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
}

const { title, description = site.tagline, type = 'website' } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name} | Security Practitioner`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const path = Astro.url.pathname;

const nav = [
  { href: '/about', label: 'About' },
  { href: '/certifications', label: 'Certifications' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Contact' },
];
const current = (href: string) => path === href || path.startsWith(`${href}/`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} blog`} href="/rss.xml" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#0d1117" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/" aria-label={`${site.name} home`}>Crisis<span>Knight</span></a>
        <nav class="nav" aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={current(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <span>&copy; {new Date().getFullYear()} {site.owner}. {site.name}.</span>
        <ul>
          <li><a href={links.linkedin} rel="noopener noreferrer">LinkedIn</a></li>
          <li><a href={links.github} rel="noopener noreferrer">GitHub</a></li>
          <li><a href={links.giac} rel="noopener noreferrer">GIAC verification</a></li>
          <li><a href="/rss.xml">RSS</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>

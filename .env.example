# Copy to .env for local use. On Hostinger, set these in the hPanel Node.js app's
# environment variables instead. Never commit a real .env.

# Port the app listens on (Hostinger usually injects this)
PORT=3000

# Reverse-proxy hops in front of the app (used for per-IP rate limiting)
TRUST_PROXY=1

# Public origin, used to validate the Origin header on the contact form
SITE_ORIGIN=https://crisisknight.com

# Cloudflare Turnstile (https://dash.cloudflare.com -> Turnstile)
# Local testing keys that always pass:
#   TURNSTILE_SITEKEY=1x00000000000000000000AA
#   TURNSTILE_SECRET=1x0000000000000000000000000000000AA
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# Where connection requests are delivered
CONTACT_TO=
CONTACT_FROM=

# SMTP account used to send them (e.g. a Hostinger mailbox)
# If SMTP_HOST is unset outside production, messages are logged instead of sent.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
